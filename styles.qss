
QPushButton {
    background-color: #4A90E2;
    color: white;
    border: none;
    padding: 6px 12px;
    font-weight: bold;
    transition: background-color 0.3s ease, transform 0.1s ease;
}

QPushButton:hover {
    background-color: #357ABD;
}


QPushButton#btnSearchCli, QPushButton#btnCleanCli, QPushButton#btnFechaltacli, QPushButton#btnResetfac {
    background-color: none;
}

QPushButton#btnSearchCli:hover, QPushButton#btnCleanCli:hover, QPushButton#btnFechaltacli:hover, QPushButton#btnResetfac:hover {
    font-size: 20px;
}

QPushButton#btnDelcli {
    background-color: #FF6666;
}

QPushButton#btnDelcli:hover {
    background-color: #FF3333;
}

QPushButton#btnDelprod {
    background-color: #FF6666;
}

QPushButton#btnDelprod:hover {
    background-color: #FF3333;
}

