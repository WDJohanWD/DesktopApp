/* ============================================================================
   JOHAN'S CLEAN & ELEGANT THEME - Professional Color Palette
   ============================================================================ */

/* ===== MAIN WINDOW & BACKGROUND ===== */
QMainWindow {
    background-color: #f5f7fa;
    color: #2c3e50;
}

QWidget {
    background-color: #f5f7fa;
    color: #2c3e50;
}

/* ===== TABS ===== */
QTabWidget::pane {
    border: 1px solid #e1e8ed;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #ecf0f5;
    color: #7f8c8d;
    padding: 10px 20px;
    border: none;
    margin: 2px;
    font-weight: 500;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #3498db;
    color: #ffffff;
    border-bottom: 3px solid #2980b9;
}

QTabBar::tab:hover:!selected {
    background-color: #d5dbdf;
    color: #2c3e50;
}

/* ===== BUTTONS - PRIMARY ===== */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1f618d;
}

/* ===== BUTTONS - SPECIAL (ICON BUTTONS) ===== */
QPushButton#btnSearchCli, 
QPushButton#btnCleanCli, 
QPushButton#btnFechaltacli {
    background-color: #ecf0f5;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px;
    color: #34495e;
}

QPushButton#btnSearchCli:hover, 
QPushButton#btnCleanCli:hover, 
QPushButton#btnFechaltacli:hover {
    background-color: #3498db;
    border-color: #3498db;
    color: white;
}

/* ===== BUTTONS - DELETE ===== */
QPushButton#btnDelcli {
    background-color: #e74c3c;
    border: none;
}

QPushButton#btnDelcli:hover {
    background-color: #c0392b;
}

/* ===== BUTTONS - SAVE/ADD ===== */
QPushButton#btnSavecli {
    background-color: #27ae60;
    border: none;
}

QPushButton#btnSavecli:hover {
    background-color: #229954;
}

/* ===== INPUT FIELDS ===== */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 8px 12px;
    color: #2c3e50;
    font-size: 11px;
    selection-background-color: #3498db;
}

QLineEdit:focus {
    border: 2px solid #3498db;
    background-color: #ffffff;
}

/* ===== COMBO BOX ===== */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 12px;
    color: #2c3e50;
    font-size: 11px;
    selection-background-color: #3498db;
}

QComboBox:focus {
    border: 2px solid #3498db;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border: none;
    border-left: 1px solid #bdc3c7;
    background: #ecf0f5;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    selection-background-color: #3498db;
    border-radius: 4px;
}

/* ===== TABLES & HEADERS ===== */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #ecf0f5;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    alternate-background-color: #f8f9fa;
}

QTableWidget::item {
    padding: 6px;
    color: #2c3e50;
    border: none;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QTableWidget::item:alternate {
    background-color: #f8f9fa;
}

QHeaderView::section {
    background-color: #34495e;
    color: #ffffff;
    padding: 8px;
    border: none;
    font-weight: 600;
    font-size: 11px;
}

QHeaderView::section:hover {
    background-color: #2c3e50;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background-color: #ecf0f5;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #95a5a6;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7f8c8d;
}

QScrollBar:horizontal {
    background-color: #ecf0f5;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #95a5a6;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7f8c8d;
}

/* ===== MENU BAR ===== */
QMenuBar {
    background-color: #ecf0f5;
    color: #2c3e50;
    border-bottom: 1px solid #bdc3c7;
    padding: 4px;
}

QMenuBar::item:selected {
    background-color: #3498db;
    color: white;
}

QMenuBar::item:pressed {
    background-color: #2980b9;
}

/* ===== MENUS ===== */
QMenu {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item:selected {
    background-color: #3498db;
    color: white;
    border-radius: 3px;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background-color: #ecf0f5;
    color: #34495e;
    border-top: 1px solid #bdc3c7;
    font-weight: 500;
    padding: 4px;
}

/* ===== TOOLBAR ===== */
QToolBar {
    background-color: #ecf0f5;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    spacing: 8px;
    padding: 8px;
}

QToolBar::separator {
    background-color: #bdc3c7;
    width: 1px;
    margin: 0px 4px;
}

/* ===== LABELS ===== */
QLabel {
    color: #2c3e50;
    font-size: 11px;
}

QLabel:disabled {
    color: #95a5a6;
}

/* ===== SPIN BOX ===== */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 4px;
    color: #2c3e50;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #ecf0f5;
    border: 1px solid #bdc3c7;
    border-radius: 2px;
    width: 16px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #ecf0f5;
    border: 1px solid #bdc3c7;
    border-radius: 2px;
    width: 16px;
}

/* ===== DIALOGS ===== */
QDialog {
    background-color: #f5f7fa;
}

/* ===== TEXT EDIT ===== */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    color: #2c3e50;
    padding: 8px;
    font-size: 11px;
}

QTextEdit:focus {
    border: 2px solid #3498db;
}

/* ===== CHECKBOXES ===== */
QCheckBox {
    color: #2c3e50;
    spacing: 6px;
    font-size: 11px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 2px;
}

QCheckBox::indicator:unchecked {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
}

QCheckBox::indicator:checked {
    background-color: #27ae60;
    border: 1px solid #27ae60;
}

/* ===== RADIO BUTTONS ===== */
QRadioButton {
    color: #2c3e50;
    spacing: 6px;
    font-size: 11px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

QRadioButton::indicator:unchecked {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
}

QRadioButton::indicator:checked {
    background-color: #3498db;
    border: 1px solid #3498db;
}

/* ===== GROUPBOX ===== */
QGroupBox {
    color: #34495e;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0px 6px 0px 6px;
}